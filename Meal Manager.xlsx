<Workbook>
    <Properties>
        <Title>Meal Manager</Title>
        <Author>GitHub Copilot</Author>
    </Properties>
    <Sheets>
        <Summary>
            <Cells>
                <Cell A1>Selected Month</Cell>
                <Cell B1>=TODAY()</Cell>
                <Cell A3>Total Meals</Cell>
                <Cell B3>=SUMIFS(tblMeals[Meals], tblMeals[Date], ">="&FirstDay, tblMeals[Date], "<="&LastDay)</Cell>
                <Cell A4>Total Expenses</Cell>
                <Cell B4>=SUMIFS(tblExpenses[Amount], tblExpenses[Date], ">="&FirstDay, tblExpenses[Date], "<="&LastDay)</Cell>
                <Cell A5>Meal Rate</Cell>
                <Cell B5>=IF(B3=0,0,B4/B3)</Cell>
            </Cells>
        </Summary>
        <Members>
            <Table Name="tblMembers">
                <Columns>
                    <Column>Name</Column>
                    <Column>JoinDate</Column>
                    <Column>Active</Column>
                </Columns>
                <Rows>
                    <Row><Cell>Alice</Cell><Cell>=TODAY()</Cell><Cell>TRUE</Cell></Row>
                    <Row><Cell>Bob</Cell><Cell>=TODAY()</Cell><Cell>TRUE</Cell></Row>
                    <Row><Cell>Charlie</Cell><Cell>=TODAY()</Cell><Cell>TRUE</Cell></Row>
                    <Row><Cell>Dana</Cell><Cell>=TODAY()</Cell><Cell>TRUE</Cell></Row>
                </Rows>
            </Table>
        </Members>
        <Meals>
            <Table Name="tblMeals">
                <Columns>
                    <Column>Date</Column>
                    <Column>Member</Column>
                    <Column>Meals</Column>
                </Columns>
                <Rows>
                    <Row><Cell>=TODAY()</Cell><Cell>Alice</Cell><Cell>2.5</Cell></Row>
                    <Row><Cell>=TODAY()+1</Cell><Cell>Bob</Cell><Cell>1.0</Cell></Row>
                    <Row><Cell>=TODAY()+2</Cell><Cell>Charlie</Cell><Cell>3.0</Cell></Row>
                    <Row><Cell>=TODAY()+3</Cell><Cell>Dana</Cell><Cell>2.0</Cell></Row>
                </Rows>
            </Table>
        </Meals>
        <Deposits>
            <Table Name="tblDeposits">
                <Columns>
                    <Column>Date</Column>
                    <Column>Member</Column>
                    <Column>Amount</Column>
                </Columns>
                <Rows>
                    <Row><Cell>=TODAY()</Cell><Cell>Alice</Cell><Cell>100.00</Cell></Row>
                    <Row><Cell>=TODAY()+1</Cell><Cell>Bob</Cell><Cell>200.00</Cell></Row>
                </Rows>
            </Table>
        </Deposits>
        <Expenses>
            <Table Name="tblExpenses">
                <Columns>
                    <Column>Date</Column>
                    <Column>Category</Column>
                    <Column>Description</Column>
                    <Column>Amount</Column>
                </Columns>
                <Rows>
                    <Row><Cell>=TODAY()</Cell><Cell>Groceries</Cell><Cell>Food</Cell><Cell>50.00</Cell></Row>
                </Rows>
            </Table>
        </Expenses>
    </Sheets>
</Workbook>